NEXT_PUBLIC_APP_URL=http://localhost:3000

# Official Meta/Instagram OAuth adapter. Use values from your Meta developer app.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
META_AUTH_URL=
META_TOKEN_URL=
META_SCOPE=

# AI provider abstraction. Keep server-side only.
AI_API_URL=
AI_API_KEY=

# Supabase/PostgreSQL REST access. Never expose service role key client-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Billing provider abstraction.
BILLING_CHECKOUT_URL=
OAUTH_STATE_SECRET=replace-with-a-long-random-secret
META_AUTH_URL=https://www.facebook.com/dialog/oauth
META_TOKEN_URL=https://graph.facebook.com/oauth/access_token
META_SCOPE=
